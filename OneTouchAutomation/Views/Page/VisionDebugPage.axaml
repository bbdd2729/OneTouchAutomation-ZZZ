<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:OneTouchAutomation.ViewModels"
             xmlns:fui="clr-namespace:AvaloniaFluentUI.Controls;assembly=AvaloniaFluentUI"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="650"
             x:Class="OneTouchAutomation.Views.VisionDebugPage"
             x:DataType="viewModels:VisionDebugViewModel">
    <Design.DataContext>
        <viewModels:VisionDebugViewModel />
    </Design.DataContext>

    <Grid Margin="8"
          RowDefinitions="Auto,*,150"
          RowSpacing="14">
        <Border Padding="16"
                BorderBrush="{DynamicResource ControlStrokeColorDefault}"
                BorderThickness="1"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="8">
            <Grid RowDefinitions="Auto,Auto"
                  RowSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="Vision Debug"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Capture a target, adjust matching parameters, then inspect the result."
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Grid Grid.Row="1"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="8">
                    <fui:CommandBar DefaultLabelPosition="Right">
                        <fui:CommandBar.PrimaryCommands>
                            <fui:CommandBarButton Label="Capture Screen"
                                                  Command="{Binding CaptureScreenCommand}" />
                            <fui:CommandBarButton Label="Capture by Title"
                                                  Command="{Binding CaptureWindowCommand}" />
                            <fui:CommandBarButton Label="Capture Window"
                                                  Command="{Binding CaptureSelectedWindowCommand}" />
                            <fui:CommandBarButton Label="Start Live"
                                                  Command="{Binding StartContinuousCaptureCommand}" />
                        </fui:CommandBar.PrimaryCommands>
                        <fui:CommandBar.SecondaryCommands>
                            <fui:CommandBarButton IconSource="Refresh"
                                                  Label="Refresh Windows"
                                                  Command="{Binding RefreshWindowsCommand}" />
                            <fui:CommandBarButton Label="Capture Client"
                                                  Command="{Binding CaptureSelectedWindowClientCommand}" />
                            <fui:CommandBarButton Label="Stop Live"
                                                  Command="{Binding StopContinuousCaptureCommand}" />
                        </fui:CommandBar.SecondaryCommands>
                    </fui:CommandBar>

                    <WrapPanel Grid.Row="1">
                    <TextBox Width="180"
                             Height="38"
                             Margin="0 0 8 0"
                             Text="{Binding WindowTitleKeyword, Mode=TwoWay}"
                             PlaceholderText="Window title" />

                    <ComboBox Width="250"
                              Height="38"
                              Margin="0 0 8 0"
                              ItemsSource="{Binding Windows}"
                              SelectedItem="{Binding SelectedWindow, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox Width="132"
                              Height="38"
                              Margin="0 0 8 0"
                              ItemsSource="{Binding ContinuousCaptureSources}"
                              SelectedItem="{Binding SelectedContinuousCaptureSource, Mode=TwoWay}" />

                    <fui:NumberBox Width="100"
                                   Height="38"
                                   Margin="0 0 8 0"
                                   Value="{Binding CaptureFramesPerSecond, Mode=TwoWay}"
                                   Minimum="1"
                                   Maximum="60"
                                   SpinButtonPlacementMode="Inline" />

                    </WrapPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,360"
              ColumnSpacing="14"
              MinHeight="260">
            <Border BorderBrush="{DynamicResource ControlStrokeColorDefault}"
                    BorderThickness="1"
                    Background="{DynamicResource ControlFillColorTertiaryBrush}"
                    CornerRadius="8">
                <Grid RowDefinitions="Auto,*">
                    <Grid Margin="16 14 16 10"
                          ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Preview"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding ScreenshotInfo}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding MatchResultText}"
                                   MaxWidth="260"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <fui:SmoothScrollViewer Grid.Row="1"
                                  Margin="12 0 12 12"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Image Source="{Binding PreviewImage}"
                               Stretch="Uniform" />
                    </fui:SmoothScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Padding="16"
                    BorderBrush="{DynamicResource ControlStrokeColorDefault}"
                    BorderThickness="1"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8">
                <fui:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Template Matching"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <fui:CommandBar DefaultLabelPosition="Right">
                                <fui:CommandBar.PrimaryCommands>
                                    <fui:CommandBarButton IconSource="Add"
                                                          Label="Choose Template"
                                                          Click="SelectTemplateFile_Click" />
                                    <fui:CommandBarButton Label="Run Match"
                                                          Command="{Binding RunMatchCommand}" />
                                    <fui:CommandBarButton Label="Click Best"
                                                          Command="{Binding ClickBestMatchCommand}" />
                                </fui:CommandBar.PrimaryCommands>
                                <fui:CommandBar.SecondaryCommands>
                                    <fui:CommandBarButton IconSource="Save"
                                                          Label="Save Output"
                                                          Command="{Binding SaveDebugOutputCommand}" />
                                </fui:CommandBar.SecondaryCommands>
                            </fui:CommandBar>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Template path"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox Text="{Binding TemplatePath}"
                                     IsReadOnly="True"
                                     PlaceholderText="Choose an image file" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Debug output folder"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <TextBox Text="{Binding DebugOutputDirectory}"
                                         IsReadOnly="True"
                                         PlaceholderText="Default local debug folder" />
                                <Button Grid.Column="1"
                                        Content="Choose Folder"
                                        Click="SelectOutputFolder_Click" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Template preview"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Border Height="132"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefault}"
                                    BorderThickness="1"
                                    Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                    CornerRadius="6">
                                <Image Source="{Binding TemplateImage}"
                                       Stretch="Uniform" />
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Threshold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Threshold, StringFormat={}{0:0.00}}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Slider Minimum="0.5"
                                    Maximum="0.99"
                                    TickFrequency="0.01"
                                    Value="{Binding Threshold, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <CheckBox Content="Use Region"
                                      IsChecked="{Binding UseRegion, Mode=TwoWay}" />
                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="8"
                                  RowSpacing="8">
                                <fui:NumberBox Value="{Binding RegionX, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                                <fui:NumberBox Grid.Column="1" Value="{Binding RegionY, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                                <fui:NumberBox Grid.Row="1" Value="{Binding RegionWidth, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" />
                                <fui:NumberBox Grid.Row="1" Grid.Column="1" Value="{Binding RegionHeight, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Click options"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="8">
                                <fui:NumberBox Value="{Binding ClickOffsetX, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                                <fui:NumberBox Grid.Column="1" Value="{Binding ClickOffsetY, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                            </Grid>
                            <ComboBox ItemsSource="{Binding ClickModes}"
                                      SelectedItem="{Binding ClickMode, Mode=TwoWay}" />
                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="8"
                                  RowSpacing="8">
                                <fui:NumberBox Value="{Binding ClickRepeatCount, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" />
                                <fui:NumberBox Grid.Column="1" Value="{Binding ClickIntervalMilliseconds, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" />
                                <fui:NumberBox Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding ClickHoldDurationMilliseconds, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Result"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding MatchResultText}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </fui:SmoothScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="12"
                BorderBrush="{DynamicResource ControlStrokeColorDefault}"
                BorderThickness="1"
                Background="{DynamicResource ControlFillColorTertiaryBrush}"
                CornerRadius="8">
            <Grid RowDefinitions="Auto,*"
                  RowSpacing="8">
                <TextBlock Text="Activity"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <fui:SmoothScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </fui:SmoothScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
