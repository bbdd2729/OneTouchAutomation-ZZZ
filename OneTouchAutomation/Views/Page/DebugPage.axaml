<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OneTouchAutomation.ViewModels"
             xmlns:constants="clr-namespace:OneTouchAutomation.Constants"
             xmlns:views="clr-namespace:OneTouchAutomation.Views"
             xmlns:fui="clr-namespace:AvaloniaFluentUI.Controls;assembly=AvaloniaFluentUI"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="OneTouchAutomation.Views.DebugPage"
             x:DataType="vm:DebugPageViewModel">
    <Design.DataContext>
        <vm:DebugPageViewModel />
    </Design.DataContext>

    <Grid Margin="32" RowDefinitions="Auto,*" RowSpacing="16">
        <fui:SegmentedView HorizontalAlignment="Left"
                           SelectedIndex="{Binding SelectedModeIndex, Mode=TwoWay}">
            <fui:SegmentedItem>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="Icon" Text="{x:Static constants:Icon.Vision}" />
                    <TextBlock Text="Vision Debug" />
                </StackPanel>
            </fui:SegmentedItem>
            <fui:SegmentedItem>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="Icon" Text="{x:Static constants:Icon.Behavior}" />
                    <TextBlock Text="Behavior Debug" />
                </StackPanel>
            </fui:SegmentedItem>
        </fui:SegmentedView>

        <views:VisionDebugPage Grid.Row="1"
                               DataContext="{Binding VisionDebug}"
                               IsVisible="{Binding $parent[UserControl].DataContext.IsVisionMode}" />
        <views:BehaviorDebugPage Grid.Row="1"
                                 DataContext="{Binding BehaviorDebug}"
                                 IsVisible="{Binding $parent[UserControl].DataContext.IsBehaviorMode}" />
    </Grid>
</UserControl>
