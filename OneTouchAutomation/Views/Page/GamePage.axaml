<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:OneTouchAutomation.Models"
             xmlns:vm="clr-namespace:OneTouchAutomation.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="OneTouchAutomation.Views.Page.GamePage"
             x:DataType="vm:GamePageViewModel"
             x:CompileBindings="True"
             Background="Transparent">
    <Design.DataContext>
        <vm:GamePageViewModel />
    </Design.DataContext>

    <Grid Margin="32"
          RowDefinitions="Auto,*"
          RowSpacing="24">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="16">
            <StackPanel Spacing="6">
                <TextBlock Text="Game Automation"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#F8FBFF" />
                <TextBlock Text="Create visual recognition behaviors and map them to automation actions."
                           FontSize="14"
                           Foreground="#B8C7D8" />
            </StackPanel>

            <Button Grid.Column="1"
                    MinWidth="132"
                    Height="38"
                    Padding="16 0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Command="{Binding AddBehaviorCommand}">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <TextBlock Text="+"
                               FontSize="18"
                               VerticalAlignment="Center" />
                    <TextBlock Text="New behavior"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="360,*"
              ColumnSpacing="18"
              MinHeight="420">
            <Border CornerRadius="8"
                    BorderBrush="#24FFFFFF"
                    BorderThickness="1"
                    Background="#1CFFFFFF">
                <Grid RowDefinitions="Auto,*">
                    <Grid Margin="18"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Text="Behaviors"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#F8FBFF" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Behaviors.Count}"
                                   Foreground="#B8C7D8" />
                    </Grid>

                    <ListBox Grid.Row="1"
                             Margin="10 0 10 10"
                             Padding="0"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Behaviors}"
                             SelectedItem="{Binding SelectedBehavior}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Margin" Value="0 0 0 8" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover">
                                <Setter Property="Background" Value="#18FFFFFF" />
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="#28FFFFFF" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:AutomationBehaviorModel">
                                <Grid Margin="12"
                                      RowDefinitions="Auto,Auto"
                                      ColumnDefinitions="*,Auto"
                                      RowSpacing="6">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#F8FBFF" />
                                    <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                                  IsChecked="{Binding IsEnabled}"
                                                  VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="2" Grid.Column="0"
                                               Text="{Binding Action}"
                                               Foreground="#B8C7D8" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    CornerRadius="8"
                    Padding="24"
                    BorderBrush="#24FFFFFF"
                    BorderThickness="1"
                    Background="#20FFFFFF">
                <Grid RowDefinitions="Auto,*"
                      DataContext="{Binding SelectedBehavior}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Behavior details"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FBFF" />
                            <TextBlock Text="Configure the recognition target and operation."
                                       Foreground="#B8C7D8" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                MinWidth="90"
                                Height="34"
                                Command="{Binding $parent[UserControl].DataContext.RemoveBehaviorCommand}">
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0 24 0 0"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="18">
                        <StackPanel Spacing="7">
                            <TextBlock Text="Name"
                                       FontSize="13"
                                       Foreground="#B8C7D8" />
                            <TextBox Text="{Binding Name, Mode=TwoWay}"
                                     PlaceholderText="Behavior name" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Spacing="7">
                            <TextBlock Text="Target"
                                       FontSize="13"
                                       Foreground="#B8C7D8" />
                            <TextBox Text="{Binding Target, Mode=TwoWay}"
                                     PlaceholderText="Window, region, or UI state" />
                        </StackPanel>

                        <Grid Grid.Row="2"
                              ColumnDefinitions="*,*"
                              ColumnSpacing="14">
                            <StackPanel Spacing="7">
                                <TextBlock Text="Trigger"
                                           FontSize="13"
                                           Foreground="#B8C7D8" />
                                <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.TriggerOptions}"
                                          SelectedItem="{Binding Trigger, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Spacing="7">
                                <TextBlock Text="Action"
                                           FontSize="13"
                                           Foreground="#B8C7D8" />
                                <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.ActionOptions}"
                                          SelectedItem="{Binding Action, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="3"
                                    Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Confidence threshold"
                                           FontSize="13"
                                           Foreground="#B8C7D8" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Confidence, StringFormat={}{0:P0}}"
                                           Foreground="#B8C7D8" />
                            </Grid>
                            <Slider Minimum="0.5"
                                    Maximum="0.99"
                                    TickFrequency="0.01"
                                    Value="{Binding Confidence, Mode=TwoWay}" />
                        </StackPanel>

                        <ToggleSwitch Grid.Row="4"
                                      Content="Enabled"
                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
