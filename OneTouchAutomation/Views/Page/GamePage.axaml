<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:OneTouchAutomation.Models"
             xmlns:vm="clr-namespace:OneTouchAutomation.ViewModels"
             xmlns:fui="clr-namespace:AvaloniaFluentUI.Controls;assembly=AvaloniaFluentUI"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="650"
             x:Class="OneTouchAutomation.Views.GamePage"
             x:DataType="vm:GamePageViewModel"
             x:CompileBindings="True"
             Background="Transparent">
    <Design.DataContext>
        <vm:GamePageViewModel />
    </Design.DataContext>

    <Grid Margin="32"
          RowDefinitions="Auto,Auto,Auto,*,150"
          RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="16">
            <StackPanel Spacing="6">
                <TextBlock Text="Game Automation"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Create tasks and run them in order against a selected game window."
                           FontSize="14"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <fui:CommandBar Grid.Column="1"
                            DefaultLabelPosition="Right">
                <fui:CommandBar.PrimaryCommands>
                    <fui:CommandBarButton IconSource="Add"
                                          Label="New Task"
                                          Command="{Binding AddTaskCommand}" />
                </fui:CommandBar.PrimaryCommands>
            </fui:CommandBar>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="260,*"
              ColumnSpacing="12">
            <ComboBox Height="36"
                      ItemsSource="{Binding Windows}"
                      SelectedItem="{Binding SelectedWindow, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <fui:CommandBar Grid.Column="1"
                            DefaultLabelPosition="Right">
                <fui:CommandBar.PrimaryCommands>
                    <fui:CommandBarButton IconSource="Refresh"
                                          Label="Refresh Windows"
                                          Command="{Binding RefreshWindowsCommand}" />
                    <fui:CommandBarButton Label="Run All"
                                          Command="{Binding RunAllCommand}" />
                    <fui:CommandBarButton Label="Cancel"
                                          Command="{Binding CancelRunCommand}" />
                </fui:CommandBar.PrimaryCommands>
                <fui:CommandBar.SecondaryCommands>
                    <fui:CommandBarButton IconSource="Save"
                                          Label="Save Tasks"
                                          Command="{Binding SaveTasksCommand}" />
                    <fui:CommandBarButton IconSource="Refresh"
                                          Label="Reload Tasks"
                                          Command="{Binding LoadTasksCommand}" />
                    <fui:CommandBarButton IconSource="Refresh"
                                          Label="Reload Workflows"
                                          Command="{Binding LoadWorkflowsCommand}" />
                </fui:CommandBar.SecondaryCommands>
            </fui:CommandBar>
        </Grid>

        <fui:InfoBar Grid.Row="2"
                     Margin="0 0 0 2"
                     Title="Task run"
                     Message="{Binding RunStatus}"
                     Severity="{Binding RunStatusSeverity}"
                     IsClosable="True"
                     IsOpen="{Binding IsRunStatusOpen, Mode=TwoWay}" />

        <Grid Grid.Row="3"
              ColumnDefinitions="330,*"
              ColumnSpacing="18"
              MinHeight="320">
            <Border BorderBrush="{DynamicResource ControlStrokeColorDefault}"
                    BorderThickness="1"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8">
                <Grid RowDefinitions="Auto,*">
                    <Grid Margin="18"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Text="Tasks"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <fui:InfoBadge Grid.Column="1"
                                       Value="{Binding Tasks.Count}"
                                       Classes="Informational" />
                    </Grid>

                    <ListBox Grid.Row="1"
                             Margin="10 0 10 10"
                             Padding="0"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Tasks}"
                             SelectedItem="{Binding SelectedTask, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:AutomationTaskModel">
                                <Grid Margin="12"
                                      RowDefinitions="Auto,Auto"
                                      ColumnDefinitions="*,Auto"
                                      RowSpacing="6">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <ToggleSwitch Grid.Column="1"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding BehaviorDisplayName}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Padding="24"
                    BorderBrush="{DynamicResource ControlStrokeColorDefault}"
                    BorderThickness="1"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8">
                <Grid DataContext="{Binding SelectedTask}"
                      RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Task Details"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Configure a template behavior for the selected task."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <fui:CommandBar Grid.Column="1"
                                        DefaultLabelPosition="Right">
                            <fui:CommandBar.PrimaryCommands>
                                <fui:CommandBarButton Label="Duplicate"
                                                      Command="{Binding $parent[UserControl].DataContext.DuplicateTaskCommand}" />
                            </fui:CommandBar.PrimaryCommands>
                            <fui:CommandBar.SecondaryCommands>
                                <fui:CommandBarButton Label="Move Up"
                                                      Command="{Binding $parent[UserControl].DataContext.MoveTaskUpCommand}" />
                                <fui:CommandBarButton Label="Move Down"
                                                      Command="{Binding $parent[UserControl].DataContext.MoveTaskDownCommand}" />
                                <fui:CommandBarButton IconSource="Delete"
                                                      Label="Remove"
                                                      Command="{Binding $parent[UserControl].DataContext.RemoveTaskCommand}" />
                            </fui:CommandBar.SecondaryCommands>
                        </fui:CommandBar>
                    </Grid>

                    <fui:SmoothScrollViewer Grid.Row="1"
                                  Margin="0 20 0 0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Task name"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox Text="{Binding Name, Mode=TwoWay}"
                                     PlaceholderText="Task name" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Spacing="6">
                            <TextBlock Text="Behavior"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.AvailableBehaviors}"
                                      SelectedValue="{Binding BehaviorId, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding Id}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Spacing="6"
                                    IsVisible="{Binding RequiresTemplate}">
                            <TextBlock Text="Template path"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <TextBox Text="{Binding TemplatePath}"
                                         IsReadOnly="True"
                                         PlaceholderText="Choose an image file" />
                                <Button Grid.Column="1"
                                        Content="Choose"
                                        Click="SelectTaskTemplateFile_Click" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="3"
                                    Spacing="8">
                            <StackPanel Spacing="8"
                                        IsVisible="{Binding RequiresTemplate}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Threshold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Threshold, StringFormat={}{0:0.00}}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider Minimum="0.5"
                                        Maximum="0.99"
                                        TickFrequency="0.01"
                                        Value="{Binding Threshold, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="6"
                                        IsVisible="{Binding IsWaitForTemplate}">
                                <TextBlock Text="Wait timeout seconds"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <fui:NumberBox Value="{Binding TimeoutSeconds, Mode=TwoWay}"
                                               Minimum="1"
                                               SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                            <StackPanel Spacing="6"
                                        IsVisible="{Binding IsPressKey}">
                                <TextBlock Text="Key"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.AvailableKeys}"
                                          SelectedItem="{Binding Key, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="6"
                                        IsVisible="{Binding IsDelay}">
                                <TextBlock Text="Delay milliseconds"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBox Text="{Binding DelayMilliseconds, Mode=TwoWay}"
                                         PlaceholderText="500" />
                            </StackPanel>
                            <StackPanel Spacing="6"
                                        IsVisible="{Binding IsWorkflowSelection}">
                                <TextBlock Text="Workflow"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.AvailableWorkflows}"
                                          SelectedValue="{Binding WorkflowId, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding Id}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="8"
                                        IsVisible="{Binding IsDailyWorkflow}">
                                <TextBlock Text="Game refresh hour"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <fui:NumberBox Value="{Binding GameRefreshHour, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="23"
                                               SpinButtonPlacementMode="Inline" />
                                <CheckBox Content="Force run even if already completed today"
                                          IsChecked="{Binding ForceDailyRun, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="8"
                                        IsVisible="{Binding IsClickTemplate}">
                                <TextBlock Text="Click options"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="8">
                                    <fui:NumberBox Value="{Binding ClickOffsetX, Mode=TwoWay}"
                                                   SpinButtonPlacementMode="Inline" />
                                    <fui:NumberBox Grid.Column="1"
                                                   Value="{Binding ClickOffsetY, Mode=TwoWay}"
                                                   SpinButtonPlacementMode="Inline" />
                                </Grid>
                                <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.AvailableClickModes}"
                                          SelectedItem="{Binding ClickMode, Mode=TwoWay}" />
                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="8">
                                    <fui:NumberBox Value="{Binding ClickRepeatCount, Mode=TwoWay}"
                                                   Minimum="1"
                                                   SpinButtonPlacementMode="Inline" />
                                    <fui:NumberBox Grid.Column="1"
                                                   Value="{Binding ClickIntervalMilliseconds, Mode=TwoWay}"
                                                   Minimum="1"
                                                   SpinButtonPlacementMode="Inline" />
                                </Grid>
                                <fui:NumberBox Value="{Binding ClickHoldDurationMilliseconds, Mode=TwoWay}"
                                               Minimum="1"
                                               SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Failure policy"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.FailurePolicies}"
                                              SelectedItem="{Binding FailurePolicy, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Spacing="6">
                                    <TextBlock Text="Retry count"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <fui:NumberBox Value="{Binding MaxRetryCount, Mode=TwoWay}"
                                                   Minimum="0"
                                                   SpinButtonPlacementMode="Inline" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="4"
                                    Spacing="8"
                                    IsVisible="{Binding RequiresTemplate}">
                            <CheckBox Content="Use Region"
                                      IsChecked="{Binding UseRegion, Mode=TwoWay}" />
                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="8"
                                  RowSpacing="8">
                                <fui:NumberBox Value="{Binding RegionX, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                                <fui:NumberBox Grid.Column="1" Value="{Binding RegionY, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                                <fui:NumberBox Grid.Row="1" Value="{Binding RegionWidth, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" />
                                <fui:NumberBox Grid.Row="1" Grid.Column="1" Value="{Binding RegionHeight, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                    </fui:SmoothScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Padding="12"
                BorderBrush="{DynamicResource ControlStrokeColorDefault}"
                BorderThickness="1"
                Background="{DynamicResource ControlFillColorTertiaryBrush}"
                CornerRadius="8">
            <Grid ColumnDefinitions="*,300"
                  ColumnSpacing="16">
                <fui:SmoothScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </fui:SmoothScrollViewer>

                <StackPanel Grid.Column="1"
                            Spacing="6">
                    <TextBlock Text="Run History"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <fui:SmoothScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RunHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </fui:SmoothScrollViewer>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
