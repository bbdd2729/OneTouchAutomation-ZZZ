<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:OneTouchAutomation.ViewModels"
             xmlns:fui="clr-namespace:AvaloniaFluentUI.Controls;assembly=AvaloniaFluentUI"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="OneTouchAutomation.Views.BehaviorDebugPage"
             x:DataType="viewModels:BehaviorDebugViewModel">
  <Design.DataContext>
    <viewModels:BehaviorDebugViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*,150"
        RowSpacing="14">
    <Grid ColumnDefinitions="220,260,*"
          ColumnSpacing="10">
      <ComboBox ItemsSource="{Binding Behaviors}"
                SelectedItem="{Binding SelectedBehavior, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <ComboBox Grid.Column="1"
                ItemsSource="{Binding Windows}"
                SelectedItem="{Binding SelectedWindow, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <fui:CommandBar Grid.Column="2"
                      DefaultLabelPosition="Right">
        <fui:CommandBar.PrimaryCommands>
          <fui:CommandBarButton IconSource="Refresh"
                                Label="Refresh Windows"
                                Command="{Binding RefreshWindowsCommand}" />
          <fui:CommandBarButton Label="Run Behavior"
                                Command="{Binding RunSelectedBehaviorCommand}" />
          <fui:CommandBarButton Label="Wait Then Click"
                                Command="{Binding RunTemplateClickWorkflowCommand}" />
        </fui:CommandBar.PrimaryCommands>
      </fui:CommandBar>
    </Grid>

    <Grid Grid.Row="1"
          ColumnDefinitions="360,*"
          ColumnSpacing="14">
      <Border CornerRadius="8"
              Padding="16"
              BorderBrush="{DynamicResource ControlStrokeColorDefault}"
              BorderThickness="1"
              Background="{DynamicResource ControlFillColorDefaultBrush}">
        <fui:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">
          <TextBlock Text="{Binding SelectedBehavior.Name}"
                     FontWeight="SemiBold" />

          <TextBlock Text="{Binding SelectedBehavior.Description}"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     TextWrapping="Wrap" />

          <StackPanel Spacing="6"
                      IsVisible="{Binding RequiresTemplate}">
            <TextBlock Text="Template path" />
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
              <TextBox Text="{Binding TemplatePath}"
                       IsReadOnly="True"
                       PlaceholderText="Choose an image file" />
              <Button Grid.Column="1"
                      Content="Choose"
                      Click="SelectTemplateFile_Click" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="8"
                      IsVisible="{Binding RequiresTemplate}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Threshold" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Threshold, StringFormat={}{0:0.00}}" />
            </Grid>

            <Slider Minimum="0.5"
                    Maximum="0.99"
                    TickFrequency="0.01"
                    Value="{Binding Threshold, Mode=TwoWay}" />
          </StackPanel>

          <StackPanel Spacing="6"
                      IsVisible="{Binding IsWaitForTemplate}">
            <TextBlock Text="Wait timeout seconds" />
            <fui:NumberBox Value="{Binding TimeoutSeconds, Mode=TwoWay}"
                           Minimum="1"
                           SpinButtonPlacementMode="Inline" />
          </StackPanel>

          <StackPanel Spacing="6"
                      IsVisible="{Binding IsPressKey}">
            <TextBlock Text="Key" />
            <ComboBox ItemsSource="{Binding AvailableKeys}"
                      SelectedItem="{Binding Key, Mode=TwoWay}" />
          </StackPanel>

          <StackPanel Spacing="6"
                      IsVisible="{Binding IsDelay}">
            <TextBlock Text="Delay milliseconds" />
            <fui:NumberBox Value="{Binding DelayMilliseconds, Mode=TwoWay}"
                           Minimum="0"
                           SpinButtonPlacementMode="Inline" />
          </StackPanel>

          <StackPanel Spacing="8"
                      IsVisible="{Binding IsClickTemplate}">
            <TextBlock Text="Click options" />
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="8">
              <fui:NumberBox Value="{Binding ClickOffsetX, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
              <fui:NumberBox Grid.Column="1" Value="{Binding ClickOffsetY, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
            </Grid>
            <ComboBox ItemsSource="{Binding AvailableClickModes}"
                      SelectedItem="{Binding ClickMode, Mode=TwoWay}" />
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="8">
              <fui:NumberBox Value="{Binding ClickRepeatCount, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" />
              <fui:NumberBox Grid.Column="1" Value="{Binding ClickIntervalMilliseconds, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" />
            </Grid>
            <fui:NumberBox Value="{Binding ClickHoldDurationMilliseconds, Mode=TwoWay}"
                           Minimum="1"
                           SpinButtonPlacementMode="Inline" />
          </StackPanel>

          <StackPanel Spacing="8"
                      IsVisible="{Binding RequiresTemplate}">
            <CheckBox Content="Use Region"
                      IsChecked="{Binding UseRegion, Mode=TwoWay}" />

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="8"
                  RowSpacing="8">
              <fui:NumberBox Value="{Binding RegionX, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
              <fui:NumberBox Grid.Column="1" Value="{Binding RegionY, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
              <fui:NumberBox Grid.Row="1" Value="{Binding RegionWidth, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" />
              <fui:NumberBox Grid.Row="1" Grid.Column="1" Value="{Binding RegionHeight, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" />
            </Grid>
          </StackPanel>
          </StackPanel>
        </fui:SmoothScrollViewer>
      </Border>

      <Border Grid.Column="1"
              CornerRadius="8"
              Padding="16"
              BorderBrush="{DynamicResource ControlStrokeColorDefault}"
              BorderThickness="1"
              Background="{DynamicResource ControlFillColorTertiaryBrush}">
        <StackPanel Spacing="14">
          <TextBlock Text="Result"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding ResultText}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <Separator />
          <TextBlock Text="Saved workflow test"
                     FontWeight="SemiBold" />
          <fui:CommandBar DefaultLabelPosition="Right">
            <fui:CommandBar.PrimaryCommands>
              <fui:CommandBarButton IconSource="Refresh"
                                    Label="Load Saved Workflows"
                                    Command="{Binding LoadWorkflowsCommand}" />
              <fui:CommandBarButton Label="Run Selected Workflow"
                                    Command="{Binding RunSelectedWorkflowCommand}" />
            </fui:CommandBar.PrimaryCommands>
          </fui:CommandBar>
          <ComboBox ItemsSource="{Binding Workflows}"
                    SelectedItem="{Binding SelectedWorkflow, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Text="{Binding Nodes.Count, StringFormat={}{0} node(s)}"
                             FontSize="12"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            CornerRadius="8"
            Padding="12"
            BorderBrush="{DynamicResource ControlStrokeColorDefault}"
            BorderThickness="1"
            Background="{DynamicResource ControlFillColorTertiaryBrush}">
      <fui:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Logs}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        </ItemsControl>
      </fui:SmoothScrollViewer>
    </Border>
  </Grid>
</UserControl>
