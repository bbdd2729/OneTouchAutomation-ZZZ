<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:OneTouchAutomation.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="OneTouchAutomation.Views.BehaviorDebugPage"
             x:DataType="viewModels:BehaviorDebugViewModel">
  <Design.DataContext>
    <viewModels:BehaviorDebugViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*,150"
        RowSpacing="14">
    <WrapPanel ItemHeight="36"
               ItemWidth="220"
               Orientation="Horizontal">
      <ComboBox Width="220"
                ItemsSource="{Binding Behaviors}"
                SelectedItem="{Binding SelectedBehavior, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <Button Content="Refresh Windows"
              Command="{Binding RefreshWindowsCommand}" />

      <ComboBox Width="260"
                ItemsSource="{Binding Windows}"
                SelectedItem="{Binding SelectedWindow, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <Button Content="Run Selected Behavior"
              Command="{Binding RunSelectedBehaviorCommand}" />

      <Button Content="Wait Then Click"
              Command="{Binding RunTemplateClickWorkflowCommand}" />
    </WrapPanel>

    <Grid Grid.Row="1"
          ColumnDefinitions="360,*"
          ColumnSpacing="14">
      <Border CornerRadius="8"
              Padding="16"
              BorderBrush="#24FFFFFF"
              BorderThickness="1"
              Background="#1CFFFFFF">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">
          <TextBlock Text="{Binding SelectedBehavior.Name}"
                     FontWeight="SemiBold" />

          <TextBlock Text="{Binding SelectedBehavior.Description}"
                     Foreground="#B8C7D8"
                     TextWrapping="Wrap" />

          <StackPanel Spacing="6"
                      IsVisible="{Binding RequiresTemplate}">
            <TextBlock Text="Template path" />
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
              <TextBox Text="{Binding TemplatePath}"
                       IsReadOnly="True"
                       PlaceholderText="Choose an image file" />
              <Button Grid.Column="1"
                      Content="Choose"
                      Click="SelectTemplateFile_Click" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="8"
                      IsVisible="{Binding RequiresTemplate}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Threshold" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Threshold, StringFormat={}{0:0.00}}" />
            </Grid>

            <Slider Minimum="0.5"
                    Maximum="0.99"
                    TickFrequency="0.01"
                    Value="{Binding Threshold, Mode=TwoWay}" />
          </StackPanel>

          <StackPanel Spacing="6"
                      IsVisible="{Binding IsWaitForTemplate}">
            <TextBlock Text="Wait timeout seconds" />
            <TextBox Text="{Binding TimeoutSeconds, Mode=TwoWay}"
                     PlaceholderText="10" />
          </StackPanel>

          <StackPanel Spacing="6"
                      IsVisible="{Binding IsPressKey}">
            <TextBlock Text="Key" />
            <ComboBox ItemsSource="{Binding AvailableKeys}"
                      SelectedItem="{Binding Key, Mode=TwoWay}" />
          </StackPanel>

          <StackPanel Spacing="6"
                      IsVisible="{Binding IsDelay}">
            <TextBlock Text="Delay milliseconds" />
            <TextBox Text="{Binding DelayMilliseconds, Mode=TwoWay}"
                     PlaceholderText="500" />
          </StackPanel>

          <StackPanel Spacing="8"
                      IsVisible="{Binding IsClickTemplate}">
            <TextBlock Text="Click options" />
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="8">
              <TextBox Text="{Binding ClickOffsetX, Mode=TwoWay}"
                       PlaceholderText="Offset X" />
              <TextBox Grid.Column="1"
                       Text="{Binding ClickOffsetY, Mode=TwoWay}"
                       PlaceholderText="Offset Y" />
            </Grid>
            <ComboBox ItemsSource="{Binding AvailableClickModes}"
                      SelectedItem="{Binding ClickMode, Mode=TwoWay}" />
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="8">
              <TextBox Text="{Binding ClickRepeatCount, Mode=TwoWay}"
                       PlaceholderText="Repeat count" />
              <TextBox Grid.Column="1"
                       Text="{Binding ClickIntervalMilliseconds, Mode=TwoWay}"
                       PlaceholderText="Interval ms" />
            </Grid>
            <TextBox Text="{Binding ClickHoldDurationMilliseconds, Mode=TwoWay}"
                     PlaceholderText="Hold duration ms" />
          </StackPanel>

          <StackPanel Spacing="8"
                      IsVisible="{Binding RequiresTemplate}">
            <CheckBox Content="Use Region"
                      IsChecked="{Binding UseRegion, Mode=TwoWay}" />

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="8"
                  RowSpacing="8">
              <TextBox Text="{Binding RegionX, Mode=TwoWay}"
                       PlaceholderText="X" />
              <TextBox Grid.Column="1"
                       Text="{Binding RegionY, Mode=TwoWay}"
                       PlaceholderText="Y" />
              <TextBox Grid.Row="1"
                       Text="{Binding RegionWidth, Mode=TwoWay}"
                       PlaceholderText="Width" />
              <TextBox Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding RegionHeight, Mode=TwoWay}"
                       PlaceholderText="Height" />
            </Grid>
          </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="1"
              CornerRadius="8"
              Padding="16"
              BorderBrush="#24FFFFFF"
              BorderThickness="1"
              Background="#14000000">
        <StackPanel Spacing="14">
          <TextBlock Text="Result"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding ResultText}"
                     TextWrapping="Wrap"
                     Foreground="#B8C7D8" />
          <Separator />
          <TextBlock Text="Saved workflow test"
                     FontWeight="SemiBold" />
          <Button Content="Load Saved Workflows"
                  Command="{Binding LoadWorkflowsCommand}" />
          <ComboBox ItemsSource="{Binding Workflows}"
                    SelectedItem="{Binding SelectedWorkflow, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Text="{Binding Nodes.Count, StringFormat={}{0} node(s)}"
                             FontSize="12"
                             Foreground="#B8C7D8" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Run Selected Workflow"
                  Command="{Binding RunSelectedWorkflowCommand}" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            CornerRadius="8"
            Padding="12"
            BorderBrush="#24FFFFFF"
            BorderThickness="1"
            Background="#14000000">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Logs}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}"
                       FontSize="12"
                       Foreground="#B8C7D8" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
