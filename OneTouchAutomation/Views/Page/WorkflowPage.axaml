<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:OneTouchAutomation.Models"
             xmlns:vm="clr-namespace:OneTouchAutomation.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="650"
             x:Class="OneTouchAutomation.Views.WorkflowPage"
             x:DataType="vm:WorkflowPageViewModel">
    <Design.DataContext>
        <vm:WorkflowPageViewModel />
    </Design.DataContext>

    <Grid Margin="32" RowDefinitions="Auto,*,Auto" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
            <StackPanel Spacing="5">
                <TextBlock Text="Workflows" FontSize="28" FontWeight="SemiBold" Foreground="#F8FBFF" />
                <TextBlock Text="Manage reusable automation graphs." Foreground="#B8C7D8" />
            </StackPanel>
            <Button Grid.Column="1" Content="Reload" Command="{Binding LoadCommand}" />
            <Button Grid.Column="2" Content="New" Command="{Binding NewWorkflowCommand}" />
            <Button Grid.Column="3" Content="Delete" Command="{Binding DeleteWorkflowCommand}" />
            <Button Grid.Column="4" Content="Validate" Command="{Binding ValidateWorkflowCommand}" />
            <Button Grid.Column="5" Content="Save" Command="{Binding SaveCommand}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="280,*,330" ColumnSpacing="18">
            <Border BorderBrush="#24FFFFFF" BorderThickness="1" Background="#1CFFFFFF" CornerRadius="8">
                <ListBox Margin="10" ItemsSource="{Binding Workflows}" SelectedItem="{Binding SelectedWorkflow, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:WorkflowEditorModel">
                            <StackPanel Margin="10" Spacing="4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#F8FBFF" />
                                <TextBlock Text="{Binding Nodes.Count}" FontSize="12" Foreground="#B8C7D8" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Padding="20" BorderBrush="#24FFFFFF" BorderThickness="1" Background="#1CFFFFFF" CornerRadius="8">
                <Grid DataContext="{Binding SelectedWorkflow}" RowDefinitions="Auto,Auto,*" RowSpacing="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Workflow name" Foreground="#B8C7D8" />
                        <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="Workflow name" />
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="Nodes" FontWeight="SemiBold" Foreground="#F8FBFF" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Add Delay" Command="{Binding $parent[UserControl].DataContext.AddNodeCommand}" />
                        <Button Grid.Column="2" Content="Up" Command="{Binding $parent[UserControl].DataContext.MoveNodeUpCommand}" />
                        <Button Grid.Column="3" Content="Down" Command="{Binding $parent[UserControl].DataContext.MoveNodeDownCommand}" />
                        <Button Grid.Column="4" Content="Remove" Command="{Binding $parent[UserControl].DataContext.RemoveNodeCommand}" />
                    </Grid>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Nodes}" SelectedItem="{Binding $parent[UserControl].DataContext.SelectedNode, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:WorkflowNodeEditorModel">
                                <Grid Margin="8" ColumnDefinitions="*,180" ColumnSpacing="12">
                                    <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding $parent[UserControl].DataContext.AvailableBehaviors}"
                                              SelectedValue="{Binding BehaviorId, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Id}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="16" BorderBrush="#24FFFFFF" BorderThickness="1" Background="#1CFFFFFF" CornerRadius="8">
                <Grid RowDefinitions="*,Auto" RowSpacing="14">
                <ScrollViewer DataContext="{Binding SelectedNode}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Node parameters" FontWeight="SemiBold" Foreground="#F8FBFF" />
                        <StackPanel Spacing="6" IsVisible="{Binding RequiresTemplate}">
                            <TextBlock Text="Template path" Foreground="#B8C7D8" />
                            <TextBox Text="{Binding TemplatePath, Mode=TwoWay}" PlaceholderText="Template path" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Threshold" Foreground="#B8C7D8" />
                                <TextBlock Grid.Column="1" Text="{Binding Threshold, StringFormat={}{0:0.00}}" Foreground="#B8C7D8" />
                            </Grid>
                            <Slider Minimum="0.5" Maximum="0.99" Value="{Binding Threshold, Mode=TwoWay}" />
                            <CheckBox Content="Use Region" IsChecked="{Binding UseRegion, Mode=TwoWay}" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                <TextBox Text="{Binding RegionX, Mode=TwoWay}" PlaceholderText="X" />
                                <TextBox Grid.Column="1" Text="{Binding RegionY, Mode=TwoWay}" PlaceholderText="Y" />
                                <TextBox Grid.Row="1" Text="{Binding RegionWidth, Mode=TwoWay}" PlaceholderText="Width" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RegionHeight, Mode=TwoWay}" PlaceholderText="Height" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="6" IsVisible="{Binding IsScreenBehavior}">
                            <TextBlock Text="Screen ID" Foreground="#B8C7D8" />
                            <TextBox Text="{Binding ScreenId, Mode=TwoWay}" PlaceholderText="main-menu" />
                            <TextBlock Text="Excluded template path (optional)" Foreground="#B8C7D8" />
                            <TextBox Text="{Binding ExcludedTemplatePath, Mode=TwoWay}" PlaceholderText="Loading or popup template" />
                            <TextBlock Text="The screen matches when this required template is visible."
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="#B8C7D8" />
                        </StackPanel>
                        <StackPanel Spacing="6" IsVisible="{Binding RequiresTimeout}">
                            <TextBlock Text="Timeout seconds" Foreground="#B8C7D8" />
                            <TextBox Text="{Binding TimeoutSeconds, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Spacing="6" IsVisible="{Binding IsPressKey}">
                            <TextBlock Text="Key" Foreground="#B8C7D8" />
                            <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.AvailableKeys}" SelectedItem="{Binding Key, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Spacing="6" IsVisible="{Binding IsDelay}">
                            <TextBlock Text="Delay milliseconds" Foreground="#B8C7D8" />
                            <TextBox Text="{Binding DelayMilliseconds, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Spacing="6" IsVisible="{Binding IsRunWorkflow}">
                            <TextBlock Text="Workflow ID" Foreground="#B8C7D8" />
                            <TextBox Text="{Binding WorkflowId, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Spacing="8" IsVisible="{Binding IsClickTemplate}">
                            <TextBlock Text="Click options" Foreground="#B8C7D8" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <TextBox Text="{Binding ClickOffsetX, Mode=TwoWay}" PlaceholderText="Offset X" />
                                <TextBox Grid.Column="1" Text="{Binding ClickOffsetY, Mode=TwoWay}" PlaceholderText="Offset Y" />
                            </Grid>
                            <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.AvailableClickModes}" SelectedItem="{Binding ClickMode, Mode=TwoWay}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <TextBox Text="{Binding ClickRepeatCount, Mode=TwoWay}" PlaceholderText="Repeat count" />
                                <TextBox Grid.Column="1" Text="{Binding ClickIntervalMilliseconds, Mode=TwoWay}" PlaceholderText="Interval ms" />
                            </Grid>
                            <TextBox Text="{Binding ClickHoldDurationMilliseconds, Mode=TwoWay}" PlaceholderText="Hold duration ms" />
                            <CheckBox Content="Fail when template is not found" IsChecked="{Binding FailWhenNotFound, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="Transitions" FontWeight="SemiBold" Foreground="#F8FBFF" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Add" Command="{Binding AddTransitionCommand}" />
                        <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveTransitionCommand}" />
                    </Grid>
                    <ListBox MaxHeight="190"
                             ItemsSource="{Binding SelectedWorkflow.Transitions}"
                             SelectedItem="{Binding SelectedTransition, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:WorkflowTransitionEditorModel">
                                <StackPanel Margin="4" Spacing="6">
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.SelectedWorkflow.Nodes}"
                                                  SelectedValue="{Binding FromNodeId, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding Id}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding $parent[UserControl].DataContext.AvailableOutcomes}"
                                                  SelectedItem="{Binding Outcome, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBox Text="{Binding ExpectedStatus, Mode=TwoWay}"
                                             PlaceholderText="Status code (optional)" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.SelectedWorkflow.Nodes}"
                                                  SelectedValue="{Binding ToNodeId, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding Id}"
                                                  IsEnabled="{Binding !IsTerminal}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <CheckBox Grid.Column="1" Content="End" IsChecked="{Binding IsTerminal, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="#B8C7D8" />
    </Grid>
</UserControl>
