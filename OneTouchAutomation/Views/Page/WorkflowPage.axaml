<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:OneTouchAutomation.Models"
             xmlns:vm="clr-namespace:OneTouchAutomation.ViewModels"
             xmlns:fui="clr-namespace:AvaloniaFluentUI.Controls;assembly=AvaloniaFluentUI"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="650"
             x:Class="OneTouchAutomation.Views.WorkflowPage"
             x:DataType="vm:WorkflowPageViewModel">
    <Design.DataContext>
        <vm:WorkflowPageViewModel />
    </Design.DataContext>

    <Grid Margin="32" RowDefinitions="Auto,*,Auto" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="5">
                <TextBlock Text="Workflows" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Manage reusable automation graphs." Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <fui:CommandBar Grid.Column="1"
                            DefaultLabelPosition="Right">
                <fui:CommandBar.PrimaryCommands>
                    <fui:CommandBarButton IconSource="Refresh" Label="Reload" Command="{Binding LoadCommand}" />
                    <fui:CommandBarButton IconSource="Add" Label="New" Command="{Binding NewWorkflowCommand}" />
                    <fui:CommandBarButton IconSource="CheckMark" Label="Validate" Command="{Binding ValidateWorkflowCommand}" />
                    <fui:CommandBarButton IconSource="Save" Label="Save" Command="{Binding SaveCommand}" />
                </fui:CommandBar.PrimaryCommands>
                <fui:CommandBar.SecondaryCommands>
                    <fui:CommandBarButton IconSource="Delete" Label="Delete" Command="{Binding DeleteWorkflowCommand}" />
                </fui:CommandBar.SecondaryCommands>
            </fui:CommandBar>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="280,*,330" ColumnSpacing="18">
            <Border BorderBrush="{DynamicResource ControlStrokeColorDefault}" BorderThickness="1" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8">
                <ListBox Margin="10" ItemsSource="{Binding Workflows}" SelectedItem="{Binding SelectedWorkflow, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:WorkflowEditorModel">
                            <StackPanel Margin="10" Spacing="4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Nodes.Count}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Padding="20" BorderBrush="{DynamicResource ControlStrokeColorDefault}" BorderThickness="1" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8">
                <Grid DataContext="{Binding SelectedWorkflow}" RowDefinitions="Auto,Auto,*" RowSpacing="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Workflow name" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="Workflow name" />
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="Nodes" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <fui:CommandBar Grid.Column="1" DefaultLabelPosition="Right">
                            <fui:CommandBar.PrimaryCommands>
                                <fui:CommandBarButton IconSource="Add" Label="Add Delay" Command="{Binding $parent[UserControl].DataContext.AddNodeCommand}" />
                            </fui:CommandBar.PrimaryCommands>
                            <fui:CommandBar.SecondaryCommands>
                                <fui:CommandBarButton Label="Move Up" Command="{Binding $parent[UserControl].DataContext.MoveNodeUpCommand}" />
                                <fui:CommandBarButton Label="Move Down" Command="{Binding $parent[UserControl].DataContext.MoveNodeDownCommand}" />
                                <fui:CommandBarButton IconSource="Delete" Label="Remove" Command="{Binding $parent[UserControl].DataContext.RemoveNodeCommand}" />
                            </fui:CommandBar.SecondaryCommands>
                        </fui:CommandBar>
                    </Grid>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Nodes}" SelectedItem="{Binding $parent[UserControl].DataContext.SelectedNode, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:WorkflowNodeEditorModel">
                                <Grid Margin="8" ColumnDefinitions="*,180" ColumnSpacing="12">
                                    <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding $parent[UserControl].DataContext.AvailableBehaviors}"
                                              SelectedValue="{Binding BehaviorId, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Id}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="16" BorderBrush="{DynamicResource ControlStrokeColorDefault}" BorderThickness="1" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8">
                <Grid RowDefinitions="*,Auto" RowSpacing="14">
                <fui:SmoothScrollViewer DataContext="{Binding SelectedNode}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Node parameters" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <StackPanel Spacing="6" IsVisible="{Binding RequiresTemplate}">
                            <TextBlock Text="Template path" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox Text="{Binding TemplatePath, Mode=TwoWay}" PlaceholderText="Template path" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Threshold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Threshold, StringFormat={}{0:0.00}}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Slider Minimum="0.5" Maximum="0.99" Value="{Binding Threshold, Mode=TwoWay}" />
                            <CheckBox Content="Use Region" IsChecked="{Binding UseRegion, Mode=TwoWay}" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                <fui:NumberBox Value="{Binding RegionX, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                                <fui:NumberBox Grid.Column="1" Value="{Binding RegionY, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                                <fui:NumberBox Grid.Row="1" Value="{Binding RegionWidth, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" />
                                <fui:NumberBox Grid.Row="1" Grid.Column="1" Value="{Binding RegionHeight, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="6" IsVisible="{Binding IsScreenBehavior}">
                            <TextBlock Text="Screen ID" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox Text="{Binding ScreenId, Mode=TwoWay}" PlaceholderText="main-menu" />
                            <TextBlock Text="Excluded template path (optional)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox Text="{Binding ExcludedTemplatePath, Mode=TwoWay}" PlaceholderText="Loading or popup template" />
                            <TextBlock Text="The screen matches when this required template is visible."
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="6" IsVisible="{Binding RequiresTimeout}">
                            <TextBlock Text="Timeout seconds" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <fui:NumberBox Value="{Binding TimeoutSeconds, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" />
                        </StackPanel>
                        <StackPanel Spacing="6" IsVisible="{Binding IsPressKey}">
                            <TextBlock Text="Key" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.AvailableKeys}" SelectedItem="{Binding Key, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Spacing="6" IsVisible="{Binding IsDelay}">
                            <TextBlock Text="Delay milliseconds" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <fui:NumberBox Value="{Binding DelayMilliseconds, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Inline" />
                        </StackPanel>
                        <StackPanel Spacing="6" IsVisible="{Binding IsRunWorkflow}">
                            <TextBlock Text="Workflow ID" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox Text="{Binding WorkflowId, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Spacing="8" IsVisible="{Binding IsClickTemplate}">
                            <TextBlock Text="Click options" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <fui:NumberBox Value="{Binding ClickOffsetX, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                                <fui:NumberBox Grid.Column="1" Value="{Binding ClickOffsetY, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                            </Grid>
                            <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.AvailableClickModes}" SelectedItem="{Binding ClickMode, Mode=TwoWay}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <fui:NumberBox Value="{Binding ClickRepeatCount, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" />
                                <fui:NumberBox Grid.Column="1" Value="{Binding ClickIntervalMilliseconds, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" />
                            </Grid>
                            <fui:NumberBox Value="{Binding ClickHoldDurationMilliseconds, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" />
                            <CheckBox Content="Fail when template is not found" IsChecked="{Binding FailWhenNotFound, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </fui:SmoothScrollViewer>
                <StackPanel Grid.Row="1" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="Transitions" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <fui:CommandBar Grid.Column="1" DefaultLabelPosition="Right">
                            <fui:CommandBar.PrimaryCommands>
                                <fui:CommandBarButton IconSource="Add" Label="Add" Command="{Binding AddTransitionCommand}" />
                            </fui:CommandBar.PrimaryCommands>
                            <fui:CommandBar.SecondaryCommands>
                                <fui:CommandBarButton IconSource="Delete" Label="Remove" Command="{Binding RemoveTransitionCommand}" />
                            </fui:CommandBar.SecondaryCommands>
                        </fui:CommandBar>
                    </Grid>
                    <ListBox MaxHeight="190"
                             ItemsSource="{Binding SelectedWorkflow.Transitions}"
                             SelectedItem="{Binding SelectedTransition, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:WorkflowTransitionEditorModel">
                                <StackPanel Margin="4" Spacing="6">
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.SelectedWorkflow.Nodes}"
                                                  SelectedValue="{Binding FromNodeId, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding Id}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding $parent[UserControl].DataContext.AvailableOutcomes}"
                                                  SelectedItem="{Binding Outcome, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBox Text="{Binding ExpectedStatus, Mode=TwoWay}"
                                             PlaceholderText="Status code (optional)" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.SelectedWorkflow.Nodes}"
                                                  SelectedValue="{Binding ToNodeId, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding Id}"
                                                  IsEnabled="{Binding !IsTerminal}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <CheckBox Grid.Column="1" Content="End" IsChecked="{Binding IsTerminal, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </Grid>
</UserControl>
