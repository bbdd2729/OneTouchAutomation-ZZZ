<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OneTouchAutomation.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OneTouchAutomation.Views.MainView"
             x:DataType="vm:MainWindowViewModel"
             xmlns:constants="clr-namespace:OneTouchAutomation.Constants"
             xmlns:models="clr-namespace:OneTouchAutomation.Models"
             Background="Transparent">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <ExperimentalAcrylicBorder x:Name="AcrylicHost"
                                CornerRadius="0">
        <ExperimentalAcrylicBorder.Material>
            <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                          TintColor="{Binding Appearance.AcrylicTintColor}"
                                          TintOpacity="{Binding Appearance.AcrylicTintOpacity}"
                                          MaterialOpacity="{Binding Appearance.AcrylicMaterialOpacity}"
                                          FallbackColor="{Binding Appearance.AcrylicFallbackColor}" />
        </ExperimentalAcrylicBorder.Material>

        <Grid Background="#33000000">
            <SplitView IsPaneOpen="{Binding IsPaneOpen}"
                       CompactPaneLength="58"
                       DisplayMode="CompactInline"
                       OpenPaneLength="260"
                       Background="Transparent"
                       PaneBackground="Transparent">
                <SplitView.Styles>
                    <Style Selector="Button.nav-toggle">
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Margin" Value="9 12 9 10" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="Background" Value="#18FFFFFF" />
                        <Setter Property="BorderBrush" Value="#22FFFFFF" />
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                    <Style Selector="Button.nav-toggle:pointerover">
                        <Setter Property="Background" Value="#28FFFFFF" />
                    </Style>
                    <Style Selector="Button.nav-toggle:pressed">
                        <Setter Property="Background" Value="#35FFFFFF" />
                    </Style>
                    <Style Selector="ListBox.nav-list">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="6 0" />
                    </Style>
                    <Style Selector="ListBox.nav-list ListBoxItem">
                        <Setter Property="MinHeight" Value="42" />
                        <Setter Property="Margin" Value="3 2" />
                        <Setter Property="Padding" Value="12 0" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#EEF6FF" />
                    </Style>
                    <Style Selector="ListBox.nav-list ListBoxItem:pointerover">
                        <Setter Property="Background" Value="#20FFFFFF" />
                    </Style>
                    <Style Selector="ListBox.nav-list ListBoxItem:selected">
                        <Setter Property="Background" Value="#32FFFFFF" />
                    </Style>
                </SplitView.Styles>

                <SplitView.Pane>
                    <Border BorderBrush="#24FFFFFF"
                            BorderThickness="0 0 1 0"
                            Background="#14000000">
                        <StackPanel Orientation="Vertical"
                                    Spacing="4"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top">
                            <Button Classes="nav-toggle"
                                    Command="{Binding TriggerPaneCommand}">
                                <TextBlock Classes="Icon"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Text="{x:Static constants:Icon.Navigation}" />
                            </Button>
                            <ListBox Classes="nav-list"
                                     ItemsSource="{Binding Items}"
                                     SelectedItem="{Binding SelectedListItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="models:SideBarItemModel">
                                        <Grid ColumnDefinitions="24,*"
                                              Height="42">
                                            <TextBlock Classes="Icon"
                                                       Grid.Column="0"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Text="{Binding IconKey}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="14 0 0 0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Title}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </SplitView.Pane>

                <SplitView.Content>
                    <Border Background="#12FFFFFF">
                        <TransitioningContentControl Content="{Binding CurrentPage}" />
                    </Border>
                </SplitView.Content>
            </SplitView>
        </Grid>
    </ExperimentalAcrylicBorder>
</UserControl>
